<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title %></title>
  <meta name="description" content="<%= it.description %>">
  <meta name="theme-color" content="#16213a">
  <%~ it.og || '' %>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="icon" href="/icons.svg#logo" type="image/svg+xml">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="ManakAI home">
        <svg class="icon icon-logo" aria-hidden="true" focusable="false"><use href="/icons.svg#logo"/></svg>
        <span class="brand-name">Manak<em>AI</em></span>
      </a>

      <!-- No-JS hamburger: label toggles a hidden checkbox, menu stays reachable by keyboard -->
      <input type="checkbox" id="nav-toggle" class="nav-toggle-input">
      <label for="nav-toggle" class="nav-toggle" aria-label="Menu">
        <svg class="icon" aria-hidden="true" focusable="false"><use href="/icons.svg#menu"/></svg>
        <span class="visually-hidden">Menu</span>
      </label>

      <nav class="site-nav" aria-label="Primary">
        <ul class="nav-list">
          <li><a class="nav-link" href="/">Home</a></li>
          <li><a class="nav-link" href="/journey/start">Start the Journey</a></li>
          <% if (it.user) { %>
            <li><a class="nav-link" href="/profile">Profile</a></li>
            <li>
              <form method="post" action="/logout" class="inline-form">
                <button type="submit" class="btn btn-ghost btn-sm">
                  <svg class="icon" aria-hidden="true" focusable="false"><use href="/icons.svg#logout"/></svg>
                  Log out
                </button>
              </form>
            </li>
          <% } else { %>
            <li><a class="btn btn-ghost btn-sm" href="/login">Log in</a></li>
            <li><a class="btn btn-primary btn-sm" href="/register">Sign up</a></li>
          <% } %>
        </ul>
      </nav>
    </div>
  </header>

  <% if (it.appNav) { %>
  <nav class="bottom-nav" aria-label="App">
    <ul>
      <li><a href="/dashboard" <%= it.appNav === 'home' ? 'aria-current="page"' : '' %>>
        <svg class="icon" aria-hidden="true" focusable="false"><use href="/icons.svg#home"/></svg><span>Home</span></a></li>
      <li><a href="/journey/start" <%= it.appNav === 'journey' ? 'aria-current="page"' : '' %>>
        <svg class="icon" aria-hidden="true" focusable="false"><use href="/icons.svg#compass"/></svg><span>Journey</span></a></li>
      <li><a href="/profile" <%= it.appNav === 'profile' ? 'aria-current="page"' : '' %>>
        <svg class="icon" aria-hidden="true" focusable="false"><use href="/icons.svg#user"/></svg><span>Profile</span></a></li>
    </ul>
  </nav>
  <% } %>

  <div id="offline-banner" class="offline-banner" hidden>
    <svg class="icon" aria-hidden="true" focusable="false"><use href="/icons.svg#offline"/></svg>
    You appear to be offline. Some pages may not be available.
  </div>

  <main id="main" class="site-main <%= it.mainClass || '' %>">
    <%~ it.content %>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-tagline">From Product to Compliance.</p>
      <p class="footer-note">ManakAI provides guidance based on official sources. It is not official BIS approval.
        Always verify requirements with the Bureau of Indian Standards.</p>
      <p class="footer-copy">&copy; 2026 ManakAI</p>
    </div>
  </footer>

  <div id="toast-region" class="toast-region" role="status" aria-live="polite"></div>

  <script type="module" src="/js/nav.js"></script>
  <script type="module" src="/js/offline.js"></script>
</body>
</html>
