<!-- Register page body. Plain form POST to /register so it works without JavaScript. -->
<section class="auth-section" aria-labelledby="register-title">
  <div class="container">
    <div class="card auth-card">
      <h1 id="register-title">Create your account</h1>
      <p class="auth-sub">One account, many products, many journeys.</p>

      <% if (it.error) { %>
      <div class="form-error" role="alert">
        <svg class="icon" aria-hidden="true" focusable="false"><use href="/icons.svg#alert"/></svg>
        <span id="register-error-text"><%= it.error %></span>
      </div>
      <% } %>

      <form method="post" action="/register" novalidate>
        <div class="field">
          <label for="reg-name">Your name</label>
          <input type="text" id="reg-name" name="name" autocomplete="name" required
                 <% if (it.error) { %>aria-invalid="true" aria-describedby="register-error-text"<% } %>>
          <p class="hint" id="reg-name-hint">So ManakAI can greet you and personalize guidance.</p>
        </div>

        <div class="field">
          <label for="reg-email">Email</label>
          <input type="email" id="reg-email" name="email" autocomplete="email" required
                 inputmode="email" <% if (it.error) { %>aria-invalid="true" aria-describedby="register-error-text"<% } %>>
          <p class="hint" id="reg-email-hint">Used only to log in. We never ask for Aadhaar, PAN or bank details.</p>
        </div>

        <div class="field">
          <label for="reg-password">Password</label>
          <input type="password" id="reg-password" name="password" autocomplete="new-password" required
                 minlength="8" aria-describedby="reg-password-hint"
                 <% if (it.error) { %>aria-invalid="true"<% } %>>
          <p class="hint" id="reg-password-hint">At least 8 characters.</p>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Create account</button>
      </form>

      <p class="auth-alt">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </div>
</section>
