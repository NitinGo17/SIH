<!-- Login page body. Plain form POST to /login so it works without JavaScript. -->
<section class="auth-section" aria-labelledby="login-title">
  <div class="container">
    <div class="card auth-card">
      <h1 id="login-title">Log in</h1>
      <p class="auth-sub">Welcome back. Pick up your journey where you left it.</p>

      <% if (it.error) { %>
      <div class="form-error" role="alert">
        <svg class="icon" aria-hidden="true" focusable="false"><use href="/icons.svg#alert"/></svg>
        <span id="login-error-text"><%= it.error %></span>
      </div>
      <% } %>

      <form method="post" action="/login" novalidate>
        <div class="field">
          <label for="login-email">Email</label>
          <input type="email" id="login-email" name="email" autocomplete="email" required
                 inputmode="email" <% if (it.error) { %>aria-invalid="true" aria-describedby="login-error-text"<% } %>>
        </div>

        <div class="field">
          <label for="login-password">Password</label>
          <input type="password" id="login-password" name="password" autocomplete="current-password" required
                 minlength="8" <% if (it.error) { %>aria-invalid="true" aria-describedby="login-error-text"<% } %>>
          <p class="hint" id="login-password-hint">Minimum 8 characters.</p>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Log in</button>
      </form>

      <p class="auth-alt">New to ManakAI? <a href="/register">Create an account</a></p>
    </div>
  </div>
</section>
