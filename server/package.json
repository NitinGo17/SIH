{
  "name": "manakai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ManakAI backend \u2014 Fastify 5, Postgres + pgvector, server-rendered pages",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "migrate": "node db/migrate.js",
    "lint": "eslint .",
    "test": "node --test test/",
    "export:static": "node scripts/export-static.js",
    "seed": "node ingestion/ingest.js ingestion/seed/led-lighting.json",
    "seed:labs": "node ingestion/ingest-labs.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@node-rs/argon2": "^2.2.1",
    "eta": "^3.5.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  }
}